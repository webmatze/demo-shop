<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Demo Shop" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site">
      <div class="wrap">
        <%= link_to root_path, class: "brand" do %>demo<span>shop</span><% end %>
        <nav><%= link_to "Products", products_path %></nav>
      </div>
    </header>
    <main class="wrap">
      <%= yield %>
    </main>
  </body>
</html>
