<div id="<%= dom_id(payout_export) %>" class="card">
  <p><strong>Range:</strong> <%= payout_export.starts_on.iso8601 %> – <%= payout_export.ends_on.iso8601 %></p>
  <% if payout_export.ready? %>
    <%= link_to "Download CSV", seller_payout_export_path(payout_export.seller, payout_export), class: "button", data: { turbo: false } %>
  <% else %>
    <p>Export requested.</p>
  <% end %>
</div>
