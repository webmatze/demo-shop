<div id="<%= dom_id order %>" class="card">
  <p>
    <strong>Order:</strong>
    <%= link_to "##{order.id}", order %>
  </p>

  <p>
    <strong>Product:</strong>
    <%= order.product.name %> × <%= order.quantity %>
  </p>

  <% if order.coupon %>
    <p>
      <strong>Coupon:</strong>
      <%= order.coupon.code %> (−<%= order.coupon.percent_off %>%)
    </p>
  <% end %>

  <p>
    <strong>Total:</strong>
    <%= number_to_currency order.total %>
  </p>
</div>
