<div id="<%= dom_id product %>" class="card">
  <p>
    <strong>Name:</strong>
    <%= product.name %>
  </p>

  <p>
    <strong>Price:</strong>
    <%= product.price %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= product.description %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= product.category&.name || "—" %>
  </p>

  <p>
    <strong>Catalog:</strong>
    <%= product.synced_at ? "synced #{product.synced_at.strftime('%H:%M:%S')}" : "pending …" %>
  </p>

</div>
